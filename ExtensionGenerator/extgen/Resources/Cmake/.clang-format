# The style the native wrapper emitter writes under code_gen/native: four spaces,
# Allman braces everywhere (functions, control statements, lambdas, else and
# catch), case labels at the switch's indent, one statement per line, no column
# limit so existing line breaks are kept. Emitted once into a new extension's
# source/ and never refreshed, so it is the extension's to edit; the generated
# code itself is never formatted. Needs clang-format 17 or newer.
Language: Cpp
Standard: c++17
BasedOnStyle: LLVM
ColumnLimit: 0
UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Leave
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: DontAlign
PointerAlignment: Left
ReferenceAlignment: Pointer
QualifierAlignment: Leave
IndentCaseLabels: false
IndentCaseBlocks: false
IndentPPDirectives: None
NamespaceIndentation: All
FixNamespaceComments: false
ReflowComments: false
SortIncludes: Never
SortUsingDeclarations: Never
IncludeBlocks: Preserve
InsertBraces: false
InsertNewlineAtEOF: false
RemoveBracesLLVM: false
RemoveParentheses: Leave
RemoveSemicolon: false
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Leave
EmptyLineAfterAccessModifier: Leave
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakStringLiterals: false
LambdaBodyIndentation: OuterScope
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: false
SpacesBeforeTrailingComments: 1
SpacesInLineCommentPrefix:
  Minimum: 1
  Maximum: -1
LineEnding: DeriveLF
